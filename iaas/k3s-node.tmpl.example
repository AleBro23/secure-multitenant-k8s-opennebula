NAME = "k3s-node"

CPU  = "1"
VCPU = "1"
MEMORY = "2560"

DISK = [
  IMAGE_ID = "1",
  SIZE = "10240" ]

NIC = [
  NETWORK = "fcc-k3s-net",
  SECURITY_GROUPS = "100" ]

GRAPHICS = [
  TYPE = "vnc",
  LISTEN = "0.0.0.0" ]

CONTEXT = [
  NETWORK = "YES",
  SSH_PUBLIC_KEY = "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY" ]

OS = [
  ARCH = "x86_64" ]
